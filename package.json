{
	"name": "PedalPlayground",
	"version": "1.0.0",
	"description": "A site to help you arrange pedals",
	"main": "gulpfile.js",
	"devDependencies": {
		"gulp": "^4.0.2",
		"sqlite3": "^5.1.6"
	},
	"scripts": {
		"start": "npm-run-all --parallel watch serve api",
		"build:sass": "sass  --no-source-map app/stylesheets:public/stylesheets",
		"watch:sass": "sass  --no-source-map --watch app/stylesheets:public/stylesheets",
		"watch": "npm-run-all --parallel watch:*",
		"serve": "browser-sync start --files app public --server --ui-port 3002",
		"api": "node server/app.js",
		"api:dev": "nodemon server/app.js",
		"build": "npm-run-all build:*",
		"postbuild": "postcss public/stylesheets/*.css -u autoprefixer cssnano -r --no-map",
		"db:setup": "node database/scripts/setup.js",
		"db:seed": "node database/scripts/seed.js",
		"db:export": "node database/scripts/export-json.js",
		"db:query": "node database/scripts/query.js",
		"db:reset": "rm -f database/pedalplayground.db && npm run db:setup && npm run db:seed",
		"db:migrate": "node database/scripts/migrate.js",
		"db:migrate:status": "node database/scripts/migrate.js status"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/PedalPlayground/pedalplayground.git"
	},
	"keywords": [
		"gulp",
		"scss",
		"front",
		"end"
	],
	"author": "Travis Lehman",
	"license": "ISC",
	"bugs": {
		"url": "https://github.com/PedalPlayground/pedalplayground/issues"
	},
	"homepage": "https://github.com/PedalPlayground/pedalplayground#readme",
	"dependencies": {
		"autoprefixer": "^10.4.2",
		"bcrypt": "^6.0.0",
		"bootstrap-colorpicker": "^2.5.2",
		"bootstrap-sass": "^3.4.1",
		"browser-sync": "^2.27.7",
		"connect-sqlite3": "^0.9.16",
		"copyfiles": "^2.4.1",
		"cors": "^2.8.5",
		"cssnano": "^5.0.17",
		"express": "^4.18.2",
		"express-rate-limit": "^8.0.1",
		"express-session": "^1.18.2",
		"nodemailer": "^7.0.5",
		"npm-run-all": "^4.1.5",
		"onchange": "^7.1.0",
		"postcss-cli": "^9.1.0",
		"sass": "^1.49.8",
		"select2": "^4.1.0-rc.0",
		"uuid": "^11.1.0",
		"validator": "^13.15.15"
	}
}
